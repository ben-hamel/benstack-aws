{
  "name": "benstack-aws",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "zod": "^4.6.7",
      "@types/bun": "^1.3.4",
      "better-auth": "1.7.25",
      "lucide-react": "^1.14.0",
      "next-themes": "^0.4.6",
      "react": "^19.2.3",
      "react-dom": "^19.2.3",
      "sonner": "^2.0.5",
      "@types/react": "^19.2.10",
      "@types/react-dom": "^19.2.3",
      "tailwindcss": "^4.1.18"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "dev:web": "turbo -F web dev",
    "dev:server": "turbo -F server dev",
    "db:push": "turbo -F @benstack-aws/db db:push",
    "db:studio": "turbo -F @benstack-aws/db db:studio",
    "db:generate": "turbo -F @benstack-aws/db db:generate",
    "db:migrate": "turbo -F @benstack-aws/db db:migrate",
    "db:start": "turbo -F @benstack-aws/db db:start",
    "db:watch": "turbo -F @benstack-aws/db db:watch",
    "db:stop": "turbo -F @benstack-aws/db db:stop",
    "db:down": "turbo -F @benstack-aws/db db:down",
    "build:lambda": "turbo -F @benstack-aws/receipt-processor build"
  },
  "dependencies": {
    "@benstack-aws/env": "workspace:*",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@benstack-aws/config": "workspace:*",
    "@types/bun": "catalog:",
    "turbo": "^2.11.10",
    "typescript": "^5"
  },
  "overrides": {
    "@babel/core": "^7.29.13",
    "baseline-browser-mapping": "^2.11.35",
    "browserslist": "^4.29.5",
    "defu": "^6.1.7",
    "dompurify": "^3.4.17",
    "katex": "~0.18.11",
    "source-map-js": "^1.2.2",
    "tsx": "^4.23.15",
    "uuid": "^13.0.2"
  },
  "packageManager": "bun@1.3.9"
}
