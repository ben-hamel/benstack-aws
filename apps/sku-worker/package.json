{
  "name": "@benstack-aws/sku-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/cli.ts",
    "pilot": "bun --env-file=../server/.env.local pilot/cli.ts",
    "auto:offline": "bun --no-env-file automatic/cli.ts",
    "auto:chatgpt": "bun --env-file=../server/.env.local automatic/chatgpt.ts",
    "test": "node --test test/*.test.ts",
    "check-types": "tsc --noEmit && tsc -p pilot/tsconfig.json && tsc -p automatic/tsconfig.json"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@benstack-aws/db": "workspace:*",
    "@benstack-aws/product-research": "workspace:*",
    "@earendil-works/chord": "1.5.0",
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-durable": "1.5.0",
    "@earendil-works/pi-schema": "1.5.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "linkedom": "0.16.11",
    "pi-web-access": "0.41.0",
    "proper-lockfile": "4.1.2"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/node": "22.19.19",
    "@types/proper-lockfile": "4.1.4",
    "typescript": "5.9.3"
  }
}
