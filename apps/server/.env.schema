# @plugin(@varlock/bitwarden-plugin)
# @initBwp(sessionTtl="8h")
# @defaultSensitive=true @defaultRequired=false
# ---

# Backend authentication signing secret.
# @required @type=string(minLength=32)
BETTER_AUTH_SECRET=bwp("benstack-aws development", field=BETTER_AUTH_SECRET)

# Backend public URL.
# @public @required @type=url
BETTER_AUTH_URL=bwp("benstack-aws development", field=BETTER_AUTH_URL)

# Allowed browser origin.
# @public @required @type=url
CORS_ORIGIN=bwp("benstack-aws development", field=CORS_ORIGIN)

# Comma-separated list of users permitted to sign in.
# This is authorization policy, not a credential; the signed-in user's email
# is also legitimately returned by the authentication API.
# @public @required
ALLOWED_EMAILS=bwp("benstack-aws development", field=ALLOWED_EMAILS)

# Primary PostgreSQL connection string.
# @required
DATABASE_URL=bwp("benstack-aws development", field=DATABASE_URL)

# Present in the legacy .env but not currently consumed by the server.
READONLY_DB_PASSWORD=bwp("benstack-aws development", field=READONLY_DB_PASSWORD)

# Present in the legacy .env but not currently consumed by the server.
CHAT_DATABASE_URL=bwp("benstack-aws development", field=CHAT_DATABASE_URL)

# S3 bucket used for receipt objects.
# @public @required
S3_RECEIPTS_BUCKET=bwp("benstack-aws development", field=S3_RECEIPTS_BUCKET)

# Optional AI provider credentials.
GOOGLE_API_KEY=bwp("benstack-aws development", field=GOOGLE_API_KEY)
GROQ_API_KEY=bwp("benstack-aws development", field=GROQ_API_KEY)
ANTHROPIC_API_KEY=bwp("benstack-aws development", field=ANTHROPIC_API_KEY)
