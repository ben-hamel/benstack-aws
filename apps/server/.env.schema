# @plugin(@varlock/bitwarden-plugin)
# @initBitwarden(accessToken=$BITWARDEN_ACCESS_TOKEN)
# @defaultSensitive=true @defaultRequired=false
# ---

# Per-device token for the Benstack AWS Local machine account.
# This item is internal by default and is not injected into the application.
# @type=bitwardenAccessToken
BITWARDEN_ACCESS_TOKEN=

# Backend authentication signing secret.
# @required @type=string(minLength=32)
BETTER_AUTH_SECRET=bitwarden("2dbf8d00-0594-42d2-9f23-b4b5018420e0")

# Backend public URL.
# @public @required @type=url @example="http://localhost:3000"
BETTER_AUTH_URL=bitwarden("f4b5dc91-93b4-4c20-b4d4-b4b5018437c3")

# Allowed browser origin.
# @public @required @type=url @example="http://localhost:3001"
CORS_ORIGIN=bitwarden("f4a2e10b-a309-4343-be74-b4b501844a68")

# Comma-separated list of users permitted to sign in.
# This is authorization policy, not a credential; the signed-in user's email
# is also legitimately returned by the authentication API.
# @public @required @example="developer@example.com,other@example.com"
ALLOWED_EMAILS=bitwarden("89b55464-51e4-47ed-94ab-b4b501845e84")

# Primary PostgreSQL connection string.
# @required @example="postgresql://user:password@localhost:5432/database"
DATABASE_URL=bitwarden("0e030544-7fc4-42e0-bcb3-b4b501847030")

# Present in the legacy .env but not currently consumed by the server.
READONLY_DB_PASSWORD=bitwarden("c8cb11d1-1fd8-45f8-8c5b-b4b50184859c")

# Present in the legacy .env but not currently consumed by the server.
CHAT_DATABASE_URL=bitwarden("d82ff83a-7594-4bfd-8969-b4b5018498b7")

# S3 bucket used for receipt objects.
# @public @required @example="my-app-development-receipts"
S3_RECEIPTS_BUCKET=bitwarden("704d8291-8520-4dca-80e6-b4b50184bc2e")

# Optional AI provider credentials.
GOOGLE_API_KEY=bitwarden("2f8e4e50-27cb-4325-8fc0-b4b50184c5aa")
GROQ_API_KEY=bitwarden("d7080158-1bb2-4812-8b05-b4b50184d881")
ANTHROPIC_API_KEY=bitwarden("af729972-3335-4aeb-a54c-b4b50184ecb9")
