# Core application configuration
NODE_ENV=development
BETTER_AUTH_URL=http://your-development-vm:3000
CORS_ORIGIN=http://your-development-vm:3001
ALLOWED_EMAILS=developer@example.com
S3_RECEIPTS_BUCKET=your-development-bucket

# Secrets: obtain real values from the team's approved secret store.
BETTER_AUTH_SECRET=replace-with-at-least-32-characters
DATABASE_URL=postgresql://user:password@host:5432/database

# Optional database configuration
READONLY_DB_PASSWORD=
CHAT_DATABASE_URL=

# Optional AI providers; configure only the providers you use.
GOOGLE_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
