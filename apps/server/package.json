{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "build:lambda": "bun build src/lambda.ts --outfile dist/lambda/index.mjs --target node --bundle --format esm",
    "check-types": "tsc -b",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "bun run --hot src/index.ts",
    "start": "bun run dist/index.mjs"
  },
  "dependencies": {
    "@ai-sdk/langchain": "^2.0.337",
    "@aws-sdk/client-s3": "^3.1164.0",
    "@aws-sdk/s3-request-presigner": "^3.1166.0",
    "@benstack-aws/auth": "workspace:*",
    "@benstack-aws/db": "workspace:*",
    "@benstack-aws/env": "workspace:*",
    "@langchain/anthropic": "1.6.2",
    "@langchain/core": "^1.3.5",
    "@langchain/langgraph": "^1.7.3",
    "@langchain/langgraph-checkpoint-postgres": "^1.1.2",
    "ai": "^6.0.329",
    "better-auth": "catalog:",
    "hono": "^4.13.17",
    "langchain": "^1.6.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@benstack-aws/config": "workspace:*",
    "@types/bun": "catalog:",
    "tsdown": "^0.16.5",
    "typescript": "^5"
  }
}
