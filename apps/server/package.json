{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "build:lambda": "bun build src/lambda.ts --outfile dist/lambda/index.mjs --target node --bundle --format esm",
    "build:web-function": "bun --no-env-file scripts/build-web-function.ts",
    "dev:web-function": "bun --no-env-file scripts/build-web-function.ts && bun --no-env-file scripts/dev-web-function.ts",
    "test:web-function": "bun --no-env-file scripts/build-web-function.ts && bun --no-env-file test test/web-function.test.ts",
    "test:auth": "bun --no-env-file test --timeout 60000 test/auth-integration.test.ts test/dev-network.test.ts",
    "check-types": "tsc -b",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "bun run --hot src/index.ts",
    "start": "bun run dist/index.mjs"
  },
  "dependencies": {
    "@ai-sdk/langchain": "^2.0.174",
    "@aws-sdk/client-s3": "^3.1030.0",
    "@aws-sdk/client-ssm": "^3.1164.0",
    "@aws-sdk/s3-request-presigner": "^3.1030.0",
    "@benstack-aws/auth": "workspace:*",
    "@benstack-aws/db": "workspace:*",
    "@benstack-aws/env": "workspace:*",
    "@benstack-aws/product-research": "workspace:*",
    "@benstack-aws/receipt-import": "workspace:*",
    "@hono/node-server": "^2.1.6",
    "@langchain/anthropic": "^1.3.28",
    "@langchain/core": "^1.1.41",
    "@langchain/langgraph": "^1.2.9",
    "@langchain/langgraph-checkpoint-postgres": "^1.0.1",
    "ai": "^6.0.168",
    "better-auth": "catalog:",
    "hono": "^4.8.2",
    "langchain": "^1.3.4",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@benstack-aws/config": "workspace:*",
    "@electric-sql/pglite": "0.5.15",
    "@playwright/test": "1.64.1",
    "@types/bun": "catalog:",
    "drizzle-kit": "^0.31.10",
    "tsdown": "^0.16.5",
    "typescript": "^5",
    "vite": "^6.2.2"
  }
}
