# @defaultSensitive=false @defaultRequired=false
# ---

# Tailscale hostname, IP, or other interface used by the Vite development server.
# Leave unset to listen only on localhost.
# @example="your-development-vm"
DEV_SERVER_HOST=

# Comma-separated hostnames allowed to access the Vite development server.
# This is development-only and is not used by the production build output.
# @example="your-development-vm,localhost"
DEV_SERVER_ALLOWED_HOSTS=

# Public backend URL embedded in the browser application at build time.
# @required @type=url @example="http://your-development-vm:3000"
VITE_SERVER_URL=
