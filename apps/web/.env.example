# Easiest workflow: bun run dev:local or bun run dev:network from repo root.
# Those commands set matching addresses automatically without changing .env files.
# Manual Vite-only development configuration:
DEV_SERVER_HOST=127.0.0.1
DEV_SERVER_ALLOWED_HOSTS=localhost
DEV_API_PROXY=0
DEV_API_PROXY_TARGET=http://127.0.0.1:3000

# Public backend URL embedded at build time for the existing separate-origin
# production setup. In dev proxy mode Vite uses window.location.origin instead.
VITE_SERVER_URL=http://127.0.0.1:3000
