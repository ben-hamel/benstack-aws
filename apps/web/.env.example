# Development-only Vite networking. For a remote Tailscale VM, these can both
# use the VM's MagicDNS hostname. They are not used by the built application.
DEV_SERVER_HOST=your-development-vm
DEV_SERVER_ALLOWED_HOSTS=your-development-vm

# Public backend URL embedded in the browser application at build time.
VITE_SERVER_URL=http://your-development-vm:3000
